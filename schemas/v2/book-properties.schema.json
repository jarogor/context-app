{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context.app/schemas/v2/book-properties.schema.json",
  "title": "Пользовательские свойства книг",
  "description": "Служебный файл app-state/book-properties.json: правки свойств книг и пользовательские теги. Ключ записи — абсолютный путь файла книги. Поле, которого нет в записи, берётся из источника; пустое значение удаляется из записи. Версия 2 добавляет описание книги (`description`).",
  "type": "object",
  "required": [
    "format",
    "version",
    "books"
  ],
  "properties": {
    "format": {
      "const": "context.book-properties",
      "description": "Метка формата документа: по ней файл опознаётся как документ приложения."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Версия формата документа."
    },
    "books": {
      "type": "object",
      "description": "Абсолютный путь книги → правка её свойств.",
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "description": "Правка свойств одной книги; отсутствующее поле берётся из источника.",
      "properties": {
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "published": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updated_at_millis": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
