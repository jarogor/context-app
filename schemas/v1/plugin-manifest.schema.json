{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context.app/schemas/v1/plugin-manifest.schema.json",
  "title": "Манифест плагина",
  "description": "Файл plugin-manifest.json в каталоге плагина. Метка формата — имя файла, версия — `contract_version`: по ней манифест сопоставляется с контрактом приложения.",
  "type": "object",
  "required": [
    "contract_version",
    "id",
    "name",
    "description",
    "host_functions"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "level": {
      "enum": [
        "framework",
        "application"
      ]
    },
    "kind": {
      "enum": [
        "framework",
        "books",
        "notes",
        "format",
        "extension"
      ]
    },
    "scope": {
      "enum": [
        "application",
        "session",
        "book"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Идентификатор плагина в формате UUID."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "export": {
      "type": "string"
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "viewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "flowing": {
      "type": "boolean"
    },
    "host_functions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "description": "Opaque-декларация секций настроек плагина."
    },
    "sample": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
